{
  "name": "finance-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "个人财务桌面应用 - 记账、股票基金、行情更新",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon:gen": "tauri icon assets/app-icon-source.png",
    "icon:brand": "python3 scripts/generate-icon.py && cp assets/app-icon-source.png public/app-logo.png && npm run icon:gen",
    "icon:prep": "python3 scripts/prepare-app-icon.py assets/app-icon-source.png assets/app-icon-source.png",
    "icon:set": "bash scripts/set-app-icon.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "antd": "^5.26.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
